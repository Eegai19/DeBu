# Base URL of the DeBu API (server/). Leave empty to run the storefront
# standalone with the bundled catalogue — forms then fall back to WhatsApp.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public URL of the storefront (used for SEO metadata & sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# UPI ID shown at checkout for UPI payments
NEXT_PUBLIC_UPI_ID=debu@upi
