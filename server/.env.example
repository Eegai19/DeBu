# ─── DeBu API ───
NODE_ENV=development
PORT=5000

# MongoDB connection string (local, Docker or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/debu

# Comma-separated list of allowed storefront origins
CLIENT_ORIGIN=http://localhost:3000

# Secret for /api/admin/* routes — send as the `x-api-key` header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-me-to-a-long-random-string
